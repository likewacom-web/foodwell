<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="14dp" android:paddingBottom="14dp"
    android:background="@drawable/widget_bg">

    <!-- header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="🐾 MeowFit" android:textColor="#9A5C72" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_chip" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="🔥 0 วัน" android:textColor="#B7791F" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- ring + numbers -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="104dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">

        <FrameLayout android:layout_width="104dp" android:layout_height="104dp">
            <ProgressBar android:id="@+id/w_ring" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_ring" />
            <LinearLayout android:layout_width="74dp" android:layout_height="74dp" android:layout_gravity="center"
                android:background="@drawable/widget_ring_center" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/w_kcal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="#2B1820" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_pct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="kcal" android:textColor="#9A7383" android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="16dp">
            <TextView android:id="@+id/w_left" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="เหลืออีก 0" android:textColor="#2B1820" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_kcal_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="kcal วันนี้" android:textColor="#9A7383" android:textSize="12sp" />
            <TextView android:id="@+id/w_water" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="💧 0 / 2,000 ml" android:textColor="#1B5E8C" android:textSize="13sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/w_water_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="9dp" android:layout_marginTop="5dp"
                android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_bar_blue" />
        </LinearLayout>
    </LinearLayout>

    <!-- actions -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <TextView android:id="@+id/w_add_water" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:gravity="center" android:text="💧 +250 ml" android:textColor="#1B5E8C" android:textSize="14sp" android:textStyle="bold"
            android:background="@drawable/widget_btn_blue" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/w_add_food" android:layout_width="0dp" android:layout_weight="1" android:layout_height="42dp"
            android:gravity="center" android:text="🍽️ บันทึกอาหาร" android:textColor="#2B1820" android:textSize="14sp" android:textStyle="bold"
            android:background="@drawable/widget_btn_pink" />
    </LinearLayout>
</LinearLayout>
