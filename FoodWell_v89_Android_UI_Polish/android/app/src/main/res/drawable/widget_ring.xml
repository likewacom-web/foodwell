<?xml version="1.0" encoding="utf-8"?>
<!-- Circular progress for the calorie ring (a horizontal ProgressBar drawing a ring by level). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.7" android:thicknessRatio="10" android:useLevel="false">
            <solid android:color="#33E887AA" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadiusRatio="2.7" android:thicknessRatio="10" android:useLevel="true">
                <gradient android:type="sweep" android:startColor="#FFF7B08A" android:endColor="#FFE887AA" />
            </shape>
        </rotate>
    </item>
</layer-list>
