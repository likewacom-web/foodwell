<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Google account backup and phone-to-phone transfer carry only the daily data
     snapshots (files/backups/); the app offers to restore them on first start. -->
<data-extraction-rules>
 <cloud-backup>
  <include domain="file" path="backups/"/>
 </cloud-backup>
 <device-transfer>
  <include domain="file" path="backups/"/>
 </device-transfer>
</data-extraction-rules>
